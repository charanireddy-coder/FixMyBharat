# ==============================================================================
# FIXMYBHARAT: AI-Powered Civic Intelligence Platform (Team SyncMates)
# Environment Configuration
# ==============================================================================

# Public Supabase Connection (Client-Side Safe)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-anon-key

# Optional: Direct Database Connection (Server-Side Only)
# DATABASE_URL="postgresql://postgres.your-project:your-password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.your-project:your-password@aws-0-region.pooler.supabase.com:5432/postgres"

# IMPORTANT SECURITY DIRECTIVE:
# NEVER expose or add SUPABASE_SERVICE_ROLE_KEY to frontend code or public client bundles!
# Service-role keys bypass row-level security and must strictly remain on protected backend servers.

# Local YOLO Computer Vision Microservice (Server-Side Only)
# Used for complaint photo object detection (Ultralytics YOLOv8n / YOLO26n)
# Defaults to http://127.0.0.1:8000 for local development.
CV_SERVICE_URL="http://127.0.0.1:8000"

# Ultralytics Platform Cloud Inference (Serverless / Netlify Deployment)
# Allows running live YOLO inference on Netlify without maintaining a Python server!
# Add these in Netlify Dashboard -> Site Configuration -> Environment Variables:
ULTRALYTICS_API_KEY=your_ultralytics_api_key_here
ULTRALYTICS_OWNER=gundeti-charani-reddy
ULTRALYTICS_PROJECT=example-project
ULTRALYTICS_MODEL=yolo26n


